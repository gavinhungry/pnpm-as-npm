#!/bin/bash

#
# npx compatibility wrapper: forwards to "npm exec" from pnpm-as-npm.
# Everything after the command name is passed to the command unchanged.
#

set -eo pipefail

die() {
  echo "npx (pnpm-as-npm): $*" >&2
  exit 1
}

NPM=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/npm
OPTS=()

while (( $# )); do
  case $1 in
    -p|--package)
      (( $# >= 2 )) || die "Option $1 requires a value"
      OPTS+=("--package=$2")
      shift
      ;;
    -c|--call)
      (( $# >= 2 )) || die "Option $1 requires a value"
      OPTS+=("--call=$2")
      shift
      ;;
    --no|--no-install) OPTS+=(--no-install) ;;
    --ignore-existing|--shell-auto-fallback*) ;;
    --)
      shift
      break
      ;;
    -*) OPTS+=("$1") ;;
    *) break ;;
  esac
  shift
done

exec "$NPM" exec "${OPTS[@]}" -- "$@"
